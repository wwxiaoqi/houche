<?xml version="1.0" encoding="utf-8"?>
<!-- 方案 6「路线」：一条折线 + 一个端点圆。
     画布 108×108，可见内容全部落在 18..90 的安全圆内（自适应图标会被裁成圆形/方圆/水滴）。
     折线：M34,34 → L50,34 → L50,70 → L70,70，描边 10、圆角端点；终点画一个 r=9 的实心圆。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:pivotX="54" android:pivotY="54" android:scaleX="0.98" android:scaleY="0.98">
    <path
        android:pathData="M34,34 L50,34 L50,70 L70,70"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <path
        android:pathData="M61,70 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 z"
        android:fillColor="#FFFFFF" />
    </group>
</vector>
